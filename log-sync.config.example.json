{
  "pantheon": {
    "enabled": true,
    "env": "live",
    "excludePlans": ["Sandbox"],
    "include": [],
    "exclude": [],
    "alias": {
      "charles-ives-society": "charles-ives"
    },
    "includeDb": true
  },
  "servers": {
    "marchingillini": {
      "env": "live",
      "sources": [
        {
          "host": "203.0.113.10",
          "user": "root",
          "port": 22,
          "identityFile": "~/.ssh/id_ed25519",
          "serverDir": "203.0.113.10",
          "paths": [
            { "remote": "/etc/apache2/logs/domlogs/mi/marchingillini.com", "as": "apache-access.log" },
            { "remote": "/etc/apache2/logs/domlogs/mi/marchingillini.com-ssl_log", "as": "apache-access__ssl.log" },
            { "remote": "/home/mi/logs/marchingillini.com-*.gz", "as": "apache-access.log", "rotated": true },
            { "remote": "/usr/local/apache/logs/error_log", "as": "apache-error.log" }
          ]
        }
      ]
    }
  }
}
