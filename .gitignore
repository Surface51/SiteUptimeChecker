# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# logs:sync / logs:ingest CLI bundles — kept out of .output so `nuxt build` (uptime) and the
# hourly logs:sync timer (jack) never fight over ownership of the same directory tree
.cli-output

# Node dependencies
node_modules

# Logs
# Root-scoped: a bare `logs` also matches source directories like app/components/logs,
# which silently excludes them from git *and* from Tailwind's source scanning.
/logs
*.log

# Log files dropped (or symlinked) in for analysis
/log-ingress

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# logs:sync config (hosts, users, key paths) — commit only the example
/log-sync.config.json
backups/
plans/

# Host-specific deploy script — see HOSTING-WORKSTATION.md 8.1
/deploy.sh
